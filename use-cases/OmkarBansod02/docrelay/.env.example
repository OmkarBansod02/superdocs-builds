# Required by the backend. Use the async SQLAlchemy PostgreSQL driver.
DATABASE_URL=postgresql+asyncpg://docrelay:docrelay@localhost:5432/docrelay

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Phase 1 placeholders. No live integration uses these values yet.
SUPERDOCS_API_KEY=your-superdocs-api-key
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback

# Reserved for a future versioned envelope-encryption service. Do not put a real
# production key in a checked-in file.
OAUTH_TOKEN_ENCRYPTION_KEY=generate-and-store-outside-source-control

# Browser-visible backend origin used only by the frontend health check.
NEXT_PUBLIC_DOCRELAY_API_URL=http://localhost:8000
